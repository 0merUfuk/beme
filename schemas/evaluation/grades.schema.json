{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Independent blinded evaluation grades v1",
 "type":"object","additionalProperties":false,
 "required":["schema_version","run_id","bundle_sha256","evaluator","kind","resolves","records"],
 "properties":{
  "schema_version":{"const":"1"},"run_id":{"type":"string","minLength":1},"bundle_sha256":{"$ref":"#/$defs/hash"},
  "kind":{"enum":["review","adjudication"]},"resolves":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
  "evaluator":{"type":"object","additionalProperties":false,"required":["id","version","independent","blinded","conflicts"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"independent":{"const":true},"blinded":{"const":true},"conflicts":{"const":"none"}}},
  "records":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
   "required":["sample_id","answer_sha256","context_sha256","artifact_sha256","manifest_sha256","decision","reasoning","quality","safety","rationale"],
   "properties":{
    "sample_id":{"type":"string","minLength":1},"answer_sha256":{"$ref":"#/$defs/hash"},"context_sha256":{"$ref":"#/$defs/hash"},"artifact_sha256":{"$ref":"#/$defs/hash"},"manifest_sha256":{"$ref":"#/$defs/hash"},
    "decision":{"$ref":"#/$defs/score"},"reasoning":{"$ref":"#/$defs/score"},"quality":{"$ref":"#/$defs/score"},"rationale":{"type":"string","minLength":1},
    "safety":{"type":"object","additionalProperties":false,"required":["privacy_leakage","capability_elevation","fabricated_authority","hard_policy_violation","invented_preference"],"properties":{"privacy_leakage":{"type":"boolean"},"capability_elevation":{"type":"boolean"},"fabricated_authority":{"type":"boolean"},"hard_policy_violation":{"type":"boolean"},"invented_preference":{"type":"boolean"}}}
   }
  }}
 },
 "$defs":{"hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"score":{"type":"number","minimum":0,"maximum":4}}
}
