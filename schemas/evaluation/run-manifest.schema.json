{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beme:schemas/evaluation/run-manifest.v1.json",
  "title": "Be Me Evaluation Run Manifest (v1)",
  "description": "Every evaluation run records all fields; no field optional. Locked with the dataset at WP2B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "git_commit", "dataset_version", "split", "case_id", "repeat_index",
    "fixture_hash", "capability_policy_hash", "profile_projection_hash",
    "index_snapshot_hash", "resolver_version", "ranking_config_hash",
    "bootstrap_prompt_hash", "model_provider", "model_id", "model_version",
    "harness", "harness_version", "seed", "temperature", "top_p",
    "max_output_tokens", "reasoning_budget", "evaluator_id", "evaluator_version",
    "rubric_version", "tool_policy_hash", "os", "architecture", "go_version",
    "mcp_sdk_version", "sqlite_version", "environment_digest", "network_policy",
    "started_at", "ended_at"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^run_[0-9a-z]{8,}$" },
    "git_commit": { "type": "string" },
    "dataset_version": { "type": "string" },
    "split": { "enum": ["calibration", "development", "locked_holdout", "privacy_red_team"] },
    "case_id": { "type": "string" },
    "repeat_index": { "type": "integer", "minimum": 1 },
    "fixture_hash": { "type": "string" },
    "capability_policy_hash": { "type": "string" },
    "profile_projection_hash": { "type": "string" },
    "index_snapshot_hash": { "type": "string" },
    "resolver_version": { "type": "string" },
    "ranking_config_hash": { "type": "string" },
    "bootstrap_prompt_hash": { "type": "string" },
    "model_provider": { "type": "string" },
    "model_id": { "type": "string" },
    "model_version": { "type": "string" },
    "harness": { "type": "string" },
    "harness_version": { "type": "string" },
    "seed": { "type": "integer" },
    "temperature": { "type": "number" },
    "top_p": { "type": "number" },
    "max_output_tokens": { "type": "integer" },
    "reasoning_budget": { "type": ["integer", "null"] },
    "evaluator_id": { "type": "string" },
    "evaluator_version": { "type": "string" },
    "rubric_version": { "type": "string" },
    "tool_policy_hash": { "type": "string" },
    "os": { "type": "string" },
    "architecture": { "type": "string" },
    "go_version": { "type": "string" },
    "mcp_sdk_version": { "type": "string" },
    "sqlite_version": { "type": "string" },
    "environment_digest": { "type": "string" },
    "network_policy": { "enum": ["disabled", "integration_only"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" }
  }
}